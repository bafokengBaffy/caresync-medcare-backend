# Template only: set these in your frontend hosting provider before building.
# VITE_* values are public and become part of the browser bundle.
# Optional: leave unset to use the same-origin /api rewrite in vercel.json.
# If set, use the deployed gateway URL and allow this frontend origin in backend CORS.
# VITE_API_BASE_URL=https://caresync-api-gateway.onrender.com
# VITE_GATEWAY_URL is only used by the local Vite development proxy.

VITE_FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID
