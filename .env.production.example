# Template only: copy these names into each production service's secret/env
# settings. Do not commit real credentials or this file as a runtime .env.
SPRING_PROFILES_ACTIVE=prod

# Use the provider's PostgreSQL connection details; require TLS in production.
SUPABASE_DB_URL=jdbc:postgresql://your-db-host:5432/your-database?sslmode=require
SUPABASE_DB_USER=replace-with-production-database-user
SUPABASE_DB_PASSWORD=replace-with-production-database-password

ALLOWED_ORIGINS=https://your-production-frontend.example
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=your-production-firebase-project-id
FIRESTORE_ENABLED=false

# Alternatively, provide split Firebase service-account values through the
# hosting platform's secret settings. The private-key value can use literal \n
# sequences; the application converts them to newlines.
# FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
# FIREBASE_PRIVATE_KEY_ID=replace-with-private-key-id
# FIREBASE_PRIVATE_KEY=replace-with-private-key
# FIREBASE_CLIENT_ID=replace-with-client-id

# The hosting platform supplies PORT. Set this only if your host requires it.
# PORT=8080

# If the host cannot provide workload identity, mount a service-account file
# securely and set this path. Never store the JSON credential in this file.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
