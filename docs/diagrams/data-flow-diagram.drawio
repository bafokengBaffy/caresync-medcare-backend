        <!-- PHI markers -->
        <mxCell id="phi-legend" value="Prototype: synthetic/anonymized test data only - no live patient data or Colab/AI processing. Production requires written approval and tested privacy, security, backup and recovery controls." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
