        <!-- DB A -->
        <mxCell id="db-A" value="Tenant A database&lt;br&gt;Configure encryption, access and backups; verify isolation" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="500" width="280" height="160" as="geometry" />
