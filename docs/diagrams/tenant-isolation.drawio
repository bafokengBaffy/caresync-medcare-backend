        <mxCell id="cr2" value="Residual risk | RLS/app configuration errors remain possible | Identity, routing and configuration errors remain possible" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=11;align=left;spacingLeft=5;" vertex="1" parent="compare-table">
