        <mxCell id="ch" value="Aspect | Prototype | Production target" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#e3f2fd;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=12;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="compare-table">
          <mxGeometry y="30" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cr1" value="Mechanism | tenant_id + RLS | Separate tenant databases in shared Elastic Pool" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=11;align=left;spacingLeft=5;" vertex="1" parent="compare-table">
          <mxGeometry y="60" width="1000" height="30" as="geometry" />
