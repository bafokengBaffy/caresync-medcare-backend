          <mxGeometry x="970" y="500" width="280" height="160" as="geometry" />
        </mxCell>
        <!-- Zero leakage guarantee -->
        <mxCell id="zero-leak" value="Separate databases reduce shared-row exposure; routing, identity, configuration, backups and testing still matter. Operational risks remain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b5e20;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="740" width="600" height="70" as="geometry" />
