# Reference values for local development. Spring Boot does not load .env files
# by itself; export these in your shell/IDE or configure them in your runtime.
SPRING_PROFILES_ACTIVE=local

# Use a local PostgreSQL database for development. Replace the credentials.
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/caresync
SUPABASE_DB_USER=caresync
SUPABASE_DB_PASSWORD=replace-with-a-local-password

# Browser origin allowed by the API gateway.
ALLOWED_ORIGINS=http://localhost:5173

# Keep cloud integrations disabled until their credentials are configured.
FIREBASE_ENABLED=false
FIRESTORE_ENABLED=false
FIREBASE_PROJECT_ID=your-project-id

# PORT is set by the hosting platform in production. For local runs, omit it
# to use each service's configured default (gateway 8080, patient 8081,
# clinical 8082, billing 8083).
# PORT=8081

# Optional for local Firebase Admin/Firestore use. Keep the credential file
# outside the repository; production should use the host's secure credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
